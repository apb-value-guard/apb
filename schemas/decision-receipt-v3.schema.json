{
  "$defs": {
    "ExcludedRoute": {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "route_id": {
          "title": "Route Id",
          "type": "string"
        }
      },
      "required": [
        "route_id",
        "reason"
      ],
      "title": "ExcludedRoute",
      "type": "object"
    },
    "ExecutionReference": {
      "additionalProperties": false,
      "properties": {
        "adapter": {
          "const": "paypal_sandbox",
          "title": "Adapter",
          "type": "string"
        },
        "duplicate": {
          "default": false,
          "title": "Duplicate",
          "type": "boolean"
        },
        "idempotency_key": {
          "title": "Idempotency Key",
          "type": "string"
        },
        "mode": {
          "enum": [
            "sandbox",
            "simulated_no_credentials"
          ],
          "title": "Mode",
          "type": "string"
        },
        "reference": {
          "title": "Reference",
          "type": "string"
        },
        "status": {
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "adapter",
        "mode",
        "reference",
        "status",
        "idempotency_key"
      ],
      "title": "ExecutionReference",
      "type": "object"
    },
    "GateResult": {
      "additionalProperties": false,
      "properties": {
        "effect": {
          "anyOf": [
            {
              "enum": [
                "ALLOW",
                "DENY",
                "STEP_UP",
                "HANDOFF"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Effect"
        },
        "evidence_ref": {
          "title": "Evidence Ref",
          "type": "string"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "gate": {
          "enum": [
            "identity",
            "authority",
            "mandate",
            "instruction",
            "beneficiary",
            "spend",
            "approval",
            "route",
            "quote",
            "execution"
          ],
          "title": "Gate",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "order": {
          "title": "Order",
          "type": "integer"
        },
        "policy_version": {
          "title": "Policy Version",
          "type": "string"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "warn",
            "missing",
            "not_reached"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "order",
        "gate",
        "label",
        "status",
        "effect",
        "reason_codes",
        "evidence_ref",
        "policy_version",
        "explanation"
      ],
      "title": "GateResult",
      "type": "object"
    },
    "Money": {
      "additionalProperties": false,
      "properties": {
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "currency",
        "value"
      ],
      "title": "Money",
      "type": "object"
    },
    "ReceiptAgent": {
      "additionalProperties": false,
      "properties": {
        "config_hash": {
          "title": "Config Hash",
          "type": "string"
        },
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Id"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "model_version": {
          "title": "Model Version",
          "type": "string"
        },
        "prompt_version": {
          "title": "Prompt Version",
          "type": "string"
        },
        "toolset_version": {
          "title": "Toolset Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "model",
        "model_version",
        "prompt_version",
        "toolset_version",
        "config_hash"
      ],
      "title": "ReceiptAgent",
      "type": "object"
    },
    "ReceiptApproval": {
      "additionalProperties": false,
      "properties": {
        "approval_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Approval Id"
        },
        "bound_mandate_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Bound Mandate Hash"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "status": {
          "enum": [
            "captured",
            "missing",
            "expired",
            "rejected",
            "not_required"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "required",
        "status",
        "approval_id",
        "bound_mandate_hash"
      ],
      "title": "ReceiptApproval",
      "type": "object"
    },
    "ReceiptAuthority": {
      "additionalProperties": false,
      "properties": {
        "approved_level": {
          "title": "Approved Level",
          "type": "integer"
        },
        "delegation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Delegation Id"
        },
        "execute": {
          "title": "Execute",
          "type": "boolean"
        },
        "max_amount": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Max Amount"
        },
        "principal_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Principal Id"
        },
        "requested_level": {
          "title": "Requested Level",
          "type": "integer"
        },
        "step_up_granted": {
          "title": "Step Up Granted",
          "type": "boolean"
        }
      },
      "required": [
        "delegation_id",
        "principal_id",
        "requested_level",
        "approved_level",
        "execute",
        "max_amount",
        "step_up_granted"
      ],
      "title": "ReceiptAuthority",
      "type": "object"
    },
    "ReceiptExecutionIntegrity": {
      "additionalProperties": false,
      "properties": {
        "duplicate_check": {
          "title": "Duplicate Check",
          "type": "string"
        },
        "idempotency_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Idempotency Key"
        },
        "quote_rechecked": {
          "title": "Quote Rechecked",
          "type": "boolean"
        }
      },
      "required": [
        "idempotency_key",
        "quote_rechecked",
        "duplicate_check"
      ],
      "title": "ReceiptExecutionIntegrity",
      "type": "object"
    },
    "ReceiptInstructionIntegrity": {
      "additionalProperties": false,
      "properties": {
        "amount_mutation": {
          "title": "Amount Mutation",
          "type": "boolean"
        },
        "beneficiary_mutation": {
          "title": "Beneficiary Mutation",
          "type": "boolean"
        },
        "external_content_untrusted": {
          "title": "External Content Untrusted",
          "type": "boolean"
        },
        "prompt_injection": {
          "title": "Prompt Injection",
          "type": "boolean"
        },
        "sources": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "external_content_untrusted",
        "prompt_injection",
        "beneficiary_mutation",
        "amount_mutation",
        "sources"
      ],
      "title": "ReceiptInstructionIntegrity",
      "type": "object"
    },
    "ReceiptPolicy": {
      "additionalProperties": false,
      "properties": {
        "bundle_version": {
          "title": "Bundle Version",
          "type": "string"
        },
        "decision_id": {
          "title": "Decision Id",
          "type": "string"
        },
        "effect": {
          "title": "Effect",
          "type": "string"
        },
        "engine": {
          "title": "Engine",
          "type": "string"
        }
      },
      "required": [
        "engine",
        "bundle_version",
        "decision_id",
        "effect"
      ],
      "title": "ReceiptPolicy",
      "type": "object"
    },
    "RouteScore": {
      "additionalProperties": false,
      "properties": {
        "delivery_minutes": {
          "title": "Delivery Minutes",
          "type": "integer"
        },
        "dvs": {
          "title": "Dvs",
          "type": "number"
        },
        "fee": {
          "$ref": "#/$defs/Money"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "recipient_amount": {
          "$ref": "#/$defs/Money"
        },
        "route_id": {
          "title": "Route Id",
          "type": "string"
        }
      },
      "required": [
        "route_id",
        "provider",
        "recipient_amount",
        "fee",
        "delivery_minutes",
        "dvs"
      ],
      "title": "RouteScore",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Observable evidence for one decision. No credentials, no chain-of-thought.",
  "properties": {
    "agent": {
      "$ref": "#/$defs/ReceiptAgent"
    },
    "approval": {
      "$ref": "#/$defs/ReceiptApproval"
    },
    "authority": {
      "$ref": "#/$defs/ReceiptAuthority"
    },
    "candidate_set": {
      "items": {
        "type": "string"
      },
      "title": "Candidate Set",
      "type": "array"
    },
    "data_mode": {
      "enum": [
        "synthetic",
        "sandbox",
        "live"
      ],
      "title": "Data Mode",
      "type": "string"
    },
    "episode_id": {
      "title": "Episode Id",
      "type": "string"
    },
    "evaluated_at": {
      "format": "date-time",
      "title": "Evaluated At",
      "type": "string"
    },
    "excluded_routes": {
      "items": {
        "$ref": "#/$defs/ExcludedRoute"
      },
      "title": "Excluded Routes",
      "type": "array"
    },
    "execution_integrity": {
      "$ref": "#/$defs/ReceiptExecutionIntegrity"
    },
    "execution_reference": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExecutionReference"
        },
        {
          "type": "null"
        }
      ]
    },
    "gates": {
      "items": {
        "$ref": "#/$defs/GateResult"
      },
      "title": "Gates",
      "type": "array"
    },
    "instruction_integrity": {
      "$ref": "#/$defs/ReceiptInstructionIntegrity"
    },
    "mandate_hash": {
      "title": "Mandate Hash",
      "type": "string"
    },
    "method_version": {
      "const": "apb-0.3-draft",
      "default": "apb-0.3-draft",
      "title": "Method Version",
      "type": "string"
    },
    "paypal_called": {
      "title": "Paypal Called",
      "type": "boolean"
    },
    "policy": {
      "$ref": "#/$defs/ReceiptPolicy"
    },
    "reason_codes": {
      "items": {
        "type": "string"
      },
      "title": "Reason Codes",
      "type": "array"
    },
    "receipt_hash": {
      "title": "Receipt Hash",
      "type": "string"
    },
    "receipt_id": {
      "title": "Receipt Id",
      "type": "string"
    },
    "receipt_version": {
      "const": "v3",
      "default": "v3",
      "title": "Receipt Version",
      "type": "string"
    },
    "route_scores": {
      "items": {
        "$ref": "#/$defs/RouteScore"
      },
      "title": "Route Scores",
      "type": "array"
    },
    "security_outcome": {
      "title": "Security Outcome",
      "type": "string"
    },
    "selected_action": {
      "enum": [
        "PAY",
        "PAUSE",
        "STOP",
        "HANDOFF"
      ],
      "title": "Selected Action",
      "type": "string"
    },
    "selected_route": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Selected Route"
    },
    "trace_manifest_hash": {
      "title": "Trace Manifest Hash",
      "type": "string"
    },
    "world_version": {
      "const": "world-0.2.0",
      "default": "world-0.2.0",
      "title": "World Version",
      "type": "string"
    }
  },
  "required": [
    "receipt_id",
    "episode_id",
    "evaluated_at",
    "mandate_hash",
    "agent",
    "authority",
    "instruction_integrity",
    "policy",
    "approval",
    "execution_integrity",
    "gates",
    "candidate_set",
    "excluded_routes",
    "route_scores",
    "selected_route",
    "selected_action",
    "security_outcome",
    "reason_codes",
    "paypal_called",
    "trace_manifest_hash",
    "data_mode",
    "execution_reference",
    "receipt_hash"
  ],
  "title": "DecisionReceiptV3",
  "type": "object"
}
