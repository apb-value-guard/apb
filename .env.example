PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_SANDBOX_RECEIVER=
# claude_cli (default) uses your Claude Code login. Also: api, none.
AI_BACKEND=claude_cli
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional. Only used when AI_BACKEND=api.
ANTHROPIC_API_KEY=
# Set to true to show the web UI's Execute in sandbox button.
ALLOW_EXECUTE=false
# Public deploy only: shows the banner and never executes.
PUBLIC_DEMO=false
# Optional: keeps wallet references stable across restarts. Use a long random value.
APB_WALLET_KEY=
